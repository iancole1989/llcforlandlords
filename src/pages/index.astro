---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/lib/site";

const now = Date.now();
const articles = (
  await getCollection(
    "articles",
    ({ data }) => !data.draft && data.publishedAt.valueOf() <= now,
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

---

<BaseLayout title="Rental Property LLC Guides for Landlords" description={SITE.description}>
  <section class="container-wide py-16 md:py-24">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-rust mb-3">
        For landlords and rental property investors
      </p>
      <h1 class="font-heading font-extrabold text-4xl md:text-5xl lg:text-6xl tracking-tight text-slate-deep leading-[1.1]">
        Plain-English LLC guidance, written for landlords.
      </h1>
      <p class="mt-6 text-lg md:text-xl text-slate-charcoal leading-relaxed">
        Real filing fees. Real timelines. Real tradeoffs. The LLC content most rental-property
        investors actually need — without the lawyer hedge or the affiliate fluff.
      </p>
    </div>
  </section>

  <section class="container-wide pb-20">
    <div class="flex items-end justify-between mb-8">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-slate-deep">
        LLC Guides
      </h2>
      <span class="text-sm text-caution">
        {articles.length} {articles.length === 1 ? "guide" : "guides"}
      </span>
    </div>

    {
      articles.length === 0 ? (
        <div class="bg-canvas-subtle border border-line rounded-md p-10 text-center">
          <p class="font-heading font-bold text-xl text-slate-deep mb-2">Articles publishing soon</p>
          <p class="text-slate-charcoal max-w-md mx-auto">
            Our editorial team is finalising the first wave of LLC-formation guides for landlords. Check back shortly.
          </p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {articles.map((article) => (
            <a
              href={`/llc-guide/${article.slug}/`}
              class="group block bg-canvas-white border border-line rounded-md p-5 hover:border-rust hover:shadow-sm transition-all"
            >
              {article.data.isPillar && (
                <span class="inline-block text-xs font-bold uppercase tracking-wider text-rust mb-2">
                  Pillar guide
                </span>
              )}
              {article.data.isComparison && (
                <span class="inline-block text-xs font-bold uppercase tracking-wider text-rust mb-2">
                  Comparison
                </span>
              )}
              <h3 class="font-heading font-bold text-lg text-slate-deep group-hover:text-rust transition-colors leading-snug">
                {article.data.title}
              </h3>
              <p class="mt-2 text-sm text-slate-charcoal leading-relaxed line-clamp-3">
                {article.data.description}
              </p>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="bg-canvas-subtle border-y border-line">
    <div class="container-wide py-14 md:py-16">
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div>
          <h2 class="font-heading font-bold text-2xl md:text-3xl text-slate-deep mb-3">
            Why we wrote this site.
          </h2>
          <p class="text-slate-charcoal leading-relaxed">
            Most LLC content online is written for "any small business owner." Landlords have
            different concerns: protecting individual properties from each other, financing
            implications of putting a deeded property into an LLC, state-by-state asset protection
            quality, and how the IRS actually treats single-member rental LLCs. We cover all of it,
            specifically.
          </p>
        </div>
        <div>
          <h2 class="font-heading font-bold text-2xl md:text-3xl text-slate-deep mb-3">
            How we work.
          </h2>
          <ul class="text-slate-charcoal leading-relaxed space-y-2 text-sm">
            <li>→ Every numerical claim is cited with primary source.</li>
            <li>→ Affiliate recommendations are tested against operator usability — not commission size.</li>
            <li>→ Templates reviewed by a licensed attorney before download.</li>
            <li>→ Every commercial article reviewed quarterly for stale data.</li>
          </ul>
          <p class="mt-3 text-sm">
            <a href="/editorial-standards/" class="text-rust underline">Read our editorial standards →</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
